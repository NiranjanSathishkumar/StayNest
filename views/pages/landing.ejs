<% layout("/layouts/boilerplate") %>

<!-- 1. HERO SECTION -->
<header class="landing-hero" id="hero">
  <div class="hero-inner">
    <div class="hero-pill-badge">
      <i class="fa-solid fa-sparkles"></i>
      <span>Handcrafted Escapes &amp; Unique Stays</span>
    </div>

    <h1 class="hero-title">
      Find Your Sanctuary, <br />
      <span class="text-gradient-coral">Anywhere in the World</span>
    </h1>

    <p class="hero-subtitle">
      Discover curated beachfront villas, cozy mountain lodges, handcrafted chalets, and city lofts with verified hosts and zero hidden fees.
    </p>

    <!-- Multi-Segment Search Widget -->
    <div class="hero-search-box">
      <form action="/listings" method="GET" class="search-segments-grid" id="landingSearchForm">
        <!-- Destination Segment -->
        <div class="search-segment">
          <label class="segment-label" for="heroSearchInput">
            <i class="fa-solid fa-location-dot"></i> Where
          </label>
          <input 
            type="text" 
            name="search" 
            id="heroSearchInput" 
            class="segment-input" 
            placeholder="Search destinations..." 
            autocomplete="off"
          />
        </div>

        <!-- Experience Category Segment -->
        <div class="search-segment">
          <label class="segment-label" for="heroCategorySelect">
            <i class="fa-solid fa-compass"></i> Experience
          </label>
          <select name="category" id="heroCategorySelect" class="segment-select">
            <option value="">All Categories</option>
            <option value="beachfront">Beachfront &amp; Coastal</option>
            <option value="cabins">Handcrafted Cabins</option>
            <option value="pools">Villas &amp; Pools</option>
            <option value="arctic">Mountain &amp; Arctic</option>
            <option value="countryside">Countryside &amp; Farms</option>
            <option value="towers">City Lofts &amp; Towers</option>
            <option value="wellness">Wellness Retreats</option>
          </select>
        </div>

        <!-- Price Range Segment -->
        <div class="search-segment">
          <label class="segment-label" for="heroPriceSelect">
            <i class="fa-solid fa-indian-rupee-sign"></i> Budget
          </label>
          <select id="heroPriceSelect" class="segment-select" onchange="applyPricePreset(this.value)">
            <option value="">Any Price</option>
            <option value="0-4000">Under ₹4,000</option>
            <option value="4000-8000">₹4,000 – ₹8,000</option>
            <option value="8000-15000">₹8,000 – ₹15,000</option>
            <option value="15000-999999">₹15,000+ (Luxury)</option>
          </select>
          <input type="hidden" name="minPrice" id="landingMinPrice" value="" />
          <input type="hidden" name="maxPrice" id="landingMaxPrice" value="" />
        </div>

        <!-- Search CTA Button -->
        <div class="search-segment d-flex align-items-center justify-content-end p-0">
          <button type="submit" class="btn btn-hero-search" id="heroSearchBtn">
            <i class="fa-solid fa-magnifying-glass"></i>
            <span>Explore</span>
          </button>
        </div>
      </form>
    </div>

    <!-- Quick Search Pill Tags -->
    <div class="quick-tags-wrap">
      <span class="me-1 opacity-75"><i class="fa-solid fa-fire text-warning me-1"></i>Trending:</span>
      <a href="/listings?search=Goa" class="quick-tag-btn">Goa</a>
      <a href="/listings?search=Manali" class="quick-tag-btn">Manali</a>
      <a href="/listings?search=Mumbai" class="quick-tag-btn">Mumbai</a>
      <a href="/listings?search=Lonavala" class="quick-tag-btn">Lonavala</a>
      <a href="/listings?category=pools" class="quick-tag-btn"><i class="fa-solid fa-water-ladder"></i> Private Pools</a>
      <a href="/listings?greatValue=true" class="quick-tag-btn"><i class="fa-solid fa-gem"></i> Great Value</a>
    </div>

    <!-- Scroll Indicator -->
    <div class="hero-scroll-indicator" id="heroScrollIndicator" aria-hidden="true">
      <span class="scroll-indicator-line"></span>
      <i class="fa-solid fa-chevron-down"></i>
    </div>
  </div>
</header>

<!-- 2. HERO STATS & TRUST BAR -->
<section class="hero-stats-bar">
  <div class="content-container">
    <div class="stats-grid">
      <div class="stat-item">
        <div class="stat-icon-wrapper">
          <i class="fa-solid fa-house-chimney"></i>
        </div>
        <div>
          <h3 class="stat-value"><%= stats.totalStays %></h3>
          <p class="stat-desc">Handcrafted Stays</p>
        </div>
      </div>

      <div class="stat-item">
        <div class="stat-icon-wrapper">
          <i class="fa-solid fa-shield-halved"></i>
        </div>
        <div>
          <h3 class="stat-value"><%= stats.verifiedHosts %></h3>
          <p class="stat-desc">100% Verified Hosts</p>
        </div>
      </div>

      <div class="stat-item">
        <div class="stat-icon-wrapper">
          <i class="fa-solid fa-users"></i>
        </div>
        <div>
          <h3 class="stat-value"><%= stats.happyGuests %></h3>
          <p class="stat-desc">Happy Travelers</p>
        </div>
      </div>

      <div class="stat-item">
        <div class="stat-icon-wrapper">
          <i class="fa-solid fa-star text-gold"></i>
        </div>
        <div>
          <h3 class="stat-value"><%= stats.avgRating %> / 5.0</h3>
          <p class="stat-desc">Average Rating</p>
        </div>
      </div>
    </div>
  </div>
</section>

<!-- 3. CURATED POPULAR DESTINATIONS -->
<section class="landing-section surface-bg" id="destinations">
  <div class="content-container">
    <div class="section-header d-flex flex-column flex-md-row justify-content-between align-items-md-end">
      <div>
        <h2 class="section-title">Iconic Travel Destinations</h2>
        <p class="section-lead">Explore top-rated regions chosen by thousands of travelers this season.</p>
      </div>
      <a href="/listings" class="btn btn-secondary mt-3 mt-md-0 align-self-start align-self-md-end">
        <span>View All Regions</span>
        <i class="fa-solid fa-arrow-right ms-2"></i>
      </a>
    </div>

    <div class="destinations-grid">
      <% for (let dest of popularDestinations) { %>
        <a href="<%= dest.filterUrl %>" class="destination-card">
          <img src="<%= dest.imageUrl %>" alt="<%= dest.name %>" class="destination-card-img" loading="lazy" />
          <div class="destination-overlay">
            <span class="destination-stamp"><%= dest.badge %></span>
            <div class="destination-info">
              <h3><%= dest.name %></h3>
              <p class="destination-tagline"><%= dest.tagline %></p>
              <div class="destination-meta">
                <span class="destination-stays"><%= dest.staysCount %></span>
                <span class="destination-arrow" aria-hidden="true"><i class="fa-solid fa-arrow-right"></i></span>
              </div>
            </div>
          </div>
        </a>
      <% } %>
    </div>
  </div>
</section>

<!-- 4. FEATURED TOP-RATED STAYS -->
<section class="landing-section paper-bg" id="featured-stays">
  <div class="content-container">
    <div class="section-header d-flex flex-column flex-md-row justify-content-between align-items-md-end">
      <div>
        <h2 class="section-title">Guest Favorite Stays</h2>
        <p class="section-lead">Top-rated vacation homes with unmatched hospitality, design, and comfort.</p>
      </div>
      <a href="/listings" class="btn btn-primary mt-3 mt-md-0 align-self-start align-self-md-end">
        <span>Browse All Stays</span>
        <i class="fa-solid fa-arrow-right ms-2"></i>
      </a>
    </div>

    <% if (featuredListings && featuredListings.length > 0) { %>
      <div class="featured-stays-grid">
        <% for (let listing of featuredListings) { %>
          <a href="/listings/<%= listing.id %>" class="featured-card">
            <div class="featured-card-img-wrap">
              <img
                src="<%= listing.image && listing.image.length > 0 ? listing.image[0].url : 'https://images.unsplash.com/photo-1613977257363-707ba9348227?q=80&w=800&auto=format&fit=crop' %>"
                alt="<%= listing.title %>"
                loading="lazy"
              />
              <% if (listing.averageRating >= 4.8) { %>
                <span class="featured-card-badge is-favorite">
                  <i class="fa-solid fa-award"></i> Guest Favorite
                </span>
              <% } else { %>
                <span class="featured-card-badge">
                  <i class="fa-solid fa-star"></i> <%= (listing.averageRating || 4.9).toFixed(1) %>
                </span>
              <% } %>
            </div>
            <div class="featured-card-body">
              <div class="featured-card-title">
                <span class="text-truncate-single"><%= listing.title %></span>
              </div>
              <p class="featured-card-location">
                <i class="fa-solid fa-location-dot text-coral"></i>
                <span><%= listing.location %><%= listing.country ? ', ' + listing.country : '' %></span>
              </p>
              <div class="featured-card-footer">
                <p class="featured-card-price">
                  <span class="featured-card-price-value">&#8377;<%= listing.price ? listing.price.toLocaleString("en-IN") : '0' %></span>
                  <span class="featured-card-price-unit">/ night</span>
                </p>
                <span class="featured-card-arrow" aria-hidden="true"><i class="fa-solid fa-arrow-right"></i></span>
              </div>
            </div>
          </a>
        <% } %>
      </div>
    <% } else { %>
      <div class="text-center py-5">
        <p class="text-muted">Explore all unique homes in our full catalog.</p>
        <a href="/listings" class="btn btn-primary">Browse Stays</a>
      </div>
    <% } %>
  </div>
</section>

<!-- 5. EXPERIENCE CATEGORIES SHOWCASE -->
<section class="landing-section surface-bg" id="categories">
  <div class="content-container">
    <div class="section-header text-center">
      <h2 class="section-title">Stay According to Your Mood</h2>
      <p class="section-lead">From serene beachfront villas to secluded forest cabins, find exactly what fits your travel style.</p>
    </div>
  </div>

  <div class="mood-pin" id="moodPin">
    <div class="mood-panels" id="moodPanels">
      <% for (let exp of experienceCategories) { %>
        <a href="/listings?category=<%= exp.categoryKey %>" class="mood-panel">
          <img src="<%= exp.imageUrl %>" alt="<%= exp.title %>" class="mood-panel-img" loading="lazy" />
          <div class="mood-panel-overlay">
            <span class="mood-panel-icon"><i class="<%= exp.icon %>"></i></span>
            <div class="mood-panel-body">
              <h3><%= exp.title %></h3>
              <p class="mood-panel-desc"><%= exp.description %></p>
              <span class="mood-panel-arrow" aria-hidden="true"><i class="fa-solid fa-arrow-right"></i></span>
            </div>
          </div>
        </a>
      <% } %>
    </div>
  </div>
</section>

<!-- 6. VALUE PROPOSITION PILLARS -->
<section class="landing-section paper-bg" id="why-staynest">
  <div class="content-container">
    <div class="section-header text-center">
      <h2 class="section-title">Why Travelers Love StayNest</h2>
      <p class="section-lead">Built with uncompromising care for guest comfort, security, and transparent hospitality.</p>
    </div>

    <div class="pillars-grid">
      <div class="pillar-card">
        <div class="pillar-icon-box coral">
          <i class="fa-solid fa-house-circle-check"></i>
        </div>
        <h3 class="pillar-title">Curated &amp; Verified</h3>
        <p class="pillar-desc">Every listing is vetted for quality, accurate photography, verified host identity, and cleanliness standards.</p>
      </div>

      <div class="pillar-card">
        <div class="pillar-icon-box pine">
          <i class="fa-solid fa-receipt"></i>
        </div>
        <h3 class="pillar-title">Transparent Pricing</h3>
        <p class="pillar-desc">No surprise check-out charges. View the exact price breakdown upfront with complete transparency.</p>
      </div>

      <div class="pillar-card pillar-card-featured">
        <div class="pillar-icon-box gold">
          <i class="fa-solid fa-bolt"></i>
        </div>
        <h3 class="pillar-title">Instant Confirmed Booking</h3>
        <p class="pillar-desc">State-of-the-art reservation protections prevent double bookings and secure your dates immediately.</p>
      </div>

      <div class="pillar-card">
        <div class="pillar-icon-box green">
          <i class="fa-solid fa-headset"></i>
        </div>
        <h3 class="pillar-title">24/7 Dedicated Support</h3>
        <p class="pillar-desc">Round-the-clock traveler concierge support and seamless host messaging for smooth check-ins and check-outs.</p>
      </div>
    </div>
  </div>
</section>

<!-- 7. HOST WITH STAYNEST CTA -->
<section class="landing-section paper-bg" id="host">
  <div class="content-container">
    <div class="host-cta-card">
      <div class="row align-items-center g-5">
        <div class="col-lg-7">
          <span class="section-eyebrow"><i class="fa-solid fa-key me-1"></i> Host Community</span>
          <h2 class="section-title">StayNest Your Place &amp; Start Earning</h2>
          <p class="section-lead">
            Turn your extra room, beach cottage, or countryside villa into steady income with StayNest's trusted host network.
          </p>

          <div class="host-steps">
            <div class="host-step-item">
              <div class="host-step-number">1</div>
              <div class="host-step-text">
                <h4>List Your Space in Minutes</h4>
                <p>Upload photos, set your house rules, and highlight amenities with our simple listing builder.</p>
              </div>
            </div>

            <div class="host-step-item">
              <div class="host-step-number">2</div>
              <div class="host-step-text">
                <h4>Set Your Own Pricing &amp; Schedule</h4>
                <p>You have 100% control over calendar availability, nightly rates, and guest criteria.</p>
              </div>
            </div>

            <div class="host-step-item">
              <div class="host-step-number">3</div>
              <div class="host-step-text">
                <h4>Welcome Verified Guests &amp; Get Paid</h4>
                <p>Receive fast, automated payouts directly to your account with full host protection.</p>
              </div>
            </div>
          </div>

          <a href="/listings/new" class="btn btn-primary d-inline-flex gap-2">
            <span>List Your Property</span>
            <i class="fa-solid fa-arrow-right"></i>
          </a>
        </div>

        <div class="col-lg-5">
          <div class="host-earning-preview">
            <span class="badge rounded-pill bg-light text-dark px-3 py-2 border mb-2" style="font-size: 0.82rem;">
              <i class="fa-solid fa-calculator text-coral me-1"></i> Host Earning Estimate
            </span>
            <h4 class="mt-2 mb-1" style="font-size: 1.1rem; color: var(--color-ink);">Potential Monthly Earnings</h4>
            <div class="earning-est-number">&#8377;48,500*</div>
            <p class="text-muted mb-4" style="font-size: 0.82rem;">Based on 12 nights booked at average region rates</p>
            <hr />
            <div class="d-flex justify-content-between text-start mb-2" style="font-size: 0.86rem;">
              <span class="text-muted">Host Protection:</span>
              <span class="fw-semibold text-success"><i class="fa-solid fa-check me-1"></i> Included</span>
            </div>
            <div class="d-flex justify-content-between text-start mb-3" style="font-size: 0.86rem;">
              <span class="text-muted">Instant Booking Payouts:</span>
              <span class="fw-semibold text-success"><i class="fa-solid fa-check me-1"></i> Direct Bank Deposit</span>
            </div>
            <a href="/listings/new" class="btn btn-secondary w-100">Calculate Your Space</a>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>

<!-- 9. GUEST TESTIMONIALS -->
<section class="landing-section surface-bg" id="testimonials">
  <div class="content-container">
    <div class="section-header text-center">
      <h2 class="section-title">Loved by Thousands of Guests</h2>
      <p class="section-lead">Read authentic reviews from travelers who found their dream stays on StayNest.</p>
    </div>

    <div class="testimonials-grid">
      <% for (let t of testimonials) { %>
        <div class="testimonial-card">
          <span class="testimonial-quote-mark" aria-hidden="true">“</span>
          <div class="testimonial-stars">
            <% for (let i = 0; i < t.rating; i++) { %>
              <i class="fa-solid fa-star"></i>
            <% } %>
          </div>
          <p class="testimonial-quote">“<%= t.comment %>”</p>
          <div class="testimonial-user">
            <img src="<%= t.avatar %>" alt="<%= t.name %>" class="testimonial-avatar" loading="lazy" />
            <div>
              <h4 class="testimonial-name"><%= t.name %></h4>
              <p class="testimonial-meta">
                <span><%= t.location %></span> &bull; <span class="text-coral"><%= t.stay %></span>
              </p>
            </div>
          </div>
        </div>
      <% } %>
    </div>
  </div>
</section>

<!-- 10. FREQUENTLY ASKED QUESTIONS -->
<section class="landing-section paper-bg" id="faq">
  <div class="content-container">
    <div class="section-header text-center">
      <h2 class="section-title">Frequently Asked Questions</h2>
      <p class="section-lead">Everything you need to know about booking and hosting on StayNest.</p>
    </div>

    <div class="faq-wrapper">
      <div class="accordion faq-accordion" id="staynestFaq">
        <!-- Item 1 -->
        <div class="accordion-item">
          <h2 class="accordion-header" id="headingOne">
            <button class="accordion-button" type="button" data-bs-toggle="collapse" data-bs-target="#collapseOne" aria-expanded="true" aria-controls="collapseOne">
              How does booking a stay on StayNest work?
            </button>
          </h2>
          <div id="collapseOne" class="accordion-collapse collapse show" aria-labelledby="headingOne" data-bs-parent="#staynestFaq">
            <div class="accordion-body">
              Search for your desired destination, dates, and number of guests. Once you select a listing, you can review its photo gallery, amenities, host details, and verified reviews. Click "Reserve" to securely confirm your booking instantly.
            </div>
          </div>
        </div>

        <!-- Item 2 -->
        <div class="accordion-item">
          <h2 class="accordion-header" id="headingTwo">
            <button class="accordion-button collapsed" type="button" data-bs-toggle="collapse" data-bs-target="#collapseTwo" aria-expanded="false" aria-controls="collapseTwo">
              Are there any hidden fees or extra taxes?
            </button>
          </h2>
          <div id="collapseTwo" class="accordion-collapse collapse" aria-labelledby="headingTwo" data-bs-parent="#staynestFaq">
            <div class="accordion-body">
              Never! We believe in 100% pricing transparency. All costs are clearly displayed before proceeding to check-out. What you see is exactly what you pay.
            </div>
          </div>
        </div>

        <!-- Item 3 -->
        <div class="accordion-item">
          <h2 class="accordion-header" id="headingThree">
            <button class="accordion-button collapsed" type="button" data-bs-toggle="collapse" data-bs-target="#collapseThree" aria-expanded="false" aria-controls="collapseThree">
              How are property listings verified?
            </button>
          </h2>
          <div id="collapseThree" class="accordion-collapse collapse" aria-labelledby="headingThree" data-bs-parent="#staynestFaq">
            <div class="accordion-body">
              Our team verifies host identities, property locations, and accuracy of listed amenities. Hosts with consistently high ratings (4.8+) and verified credentials earn the "Guest Favorite" badge.
            </div>
          </div>
        </div>

        <!-- Item 4 -->
        <div class="accordion-item">
          <h2 class="accordion-header" id="headingFour">
            <button class="accordion-button collapsed" type="button" data-bs-toggle="collapse" data-bs-target="#collapseFour" aria-expanded="false" aria-controls="collapseFour">
              Can I become a host and list my space?
            </button>
          </h2>
          <div id="collapseFour" class="accordion-collapse collapse" aria-labelledby="headingFour" data-bs-parent="#staynestFaq">
            <div class="accordion-body">
              Yes! Anyone with an extra room, apartment, or vacation villa can sign up to become a host. Listing your property takes just a few minutes, and you keep full control over your pricing and availability calendar.
            </div>
          </div>
        </div>

        <!-- Item 5 -->
        <div class="accordion-item">
          <h2 class="accordion-header" id="headingFive">
            <button class="accordion-button collapsed" type="button" data-bs-toggle="collapse" data-bs-target="#collapseFive" aria-expanded="false" aria-controls="collapseFive">
              What is StayNest's cancellation policy?
            </button>
          </h2>
          <div id="collapseFive" class="accordion-collapse collapse" aria-labelledby="headingFive" data-bs-parent="#staynestFaq">
            <div class="accordion-body">
              Cancellation policies vary by listing and host preference (Flexible, Moderate, or Strict). The exact policy is clearly displayed on the stay's reservation page prior to booking confirmation.
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>

<!-- 11. BOTTOM CALL TO ACTION BANNER -->
<section class="landing-section p-0">
  <div class="content-container">
    <div class="cta-bottom-banner">
      <h2 class="cta-bottom-title">Ready for Your Next Unforgettable Getaway?</h2>
      <p class="cta-bottom-desc">Join over 24,000 travelers discovering unique vacation homes across the country.</p>
      <div class="d-flex justify-content-center gap-3 flex-wrap">
        <a href="/listings" class="btn cta-btn-white d-inline-flex gap-2">
          <span>Start Exploring Stays</span>
          <i class="fa-solid fa-arrow-right"></i>
        </a>
        <a href="/signup" class="btn btn-secondary text-white border-white d-inline-flex gap-2" style="border-radius: var(--radius-full) !important; padding: 14px 28px !important; border-color: rgba(255,255,255,0.7) !important;">
          <i class="fa-solid fa-user-plus"></i>
          <span>Create Free Account</span>
        </a>
      </div>
    </div>
  </div>
</section>

<script>
  function applyPricePreset(val) {
    const minInput = document.getElementById("landingMinPrice");
    const maxInput = document.getElementById("landingMaxPrice");
    if (!val) {
      minInput.value = "";
      maxInput.value = "";
      return;
    }
    const [min, max] = val.split("-");
    minInput.value = min || "";
    maxInput.value = (max === "999999") ? "" : (max || "");
  }
</script>
