<% layout("/layouts/boilerplate.ejs") -%>

<style>
  .legal-page {
    max-width: 820px;
    margin: 0 auto;
  }
  .legal-hero {
    background: linear-gradient(135deg, #0f2027 0%, #203a43 50%, #2c5364 100%);
    border-radius: 24px;
    padding: 3rem 2.5rem;
    margin-bottom: 2.5rem;
    color: #fff;
    position: relative;
    overflow: hidden;
  }
  .legal-hero::before {
    content: '';
    position: absolute;
    top: -60px; right: -60px;
    width: 240px; height: 240px;
    background: rgba(255,255,255,0.04);
    border-radius: 50%;
  }
  .legal-hero::after {
    content: '';
    position: absolute;
    bottom: -80px; left: -40px;
    width: 300px; height: 300px;
    background: rgba(255,255,255,0.03);
    border-radius: 50%;
  }
  .legal-hero-icon {
    width: 56px; height: 56px;
    border-radius: 16px;
    background: rgba(255,255,255,0.12);
    display: flex; align-items: center; justify-content: center;
    font-size: 1.6rem;
    margin-bottom: 1.25rem;
    backdrop-filter: blur(8px);
  }
  .legal-hero h1 {
    font-size: 2.1rem;
    font-weight: 800;
    margin-bottom: 0.5rem;
    font-family: 'Calistoga', serif;
  }
  .legal-hero .subtitle {
    font-size: 0.95rem;
    opacity: 0.7;
  }
  .legal-updated {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    font-size: 0.8rem;
    background: rgba(255,255,255,0.1);
    border: 1px solid rgba(255,255,255,0.15);
    padding: 4px 12px;
    border-radius: 20px;
    margin-top: 1rem;
    opacity: 0.85;
  }

  .legal-toc {
    background: var(--color-paper);
    border: 1px solid var(--color-border);
    border-radius: 16px;
    padding: 1.5rem;
    margin-bottom: 2rem;
    position: sticky;
    top: 80px;
  }
  .legal-toc h2 {
    font-size: 0.85rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--color-ink-soft);
    margin-bottom: 0.75rem;
  }
  .legal-toc ol {
    padding-left: 1.2rem;
    margin: 0;
  }
  .legal-toc li {
    font-size: 0.9rem;
    margin-bottom: 0.4rem;
  }
  .legal-toc a {
    color: var(--color-coral);
    text-decoration: none;
    font-weight: 500;
    transition: opacity 0.15s;
  }
  .legal-toc a:hover { opacity: 0.7; }

  .legal-section {
    background: var(--color-paper);
    border: 1px solid var(--color-border);
    border-radius: 20px;
    padding: 2rem;
    margin-bottom: 1.25rem;
    scroll-margin-top: 90px;
  }
  .legal-section-header {
    display: flex;
    align-items: center;
    gap: 12px;
    margin-bottom: 1rem;
    padding-bottom: 1rem;
    border-bottom: 1px solid var(--color-border);
  }
  .legal-section-num {
    width: 36px; height: 36px;
    border-radius: 10px;
    background: linear-gradient(135deg, #2c5364, #203a43);
    color: #fff;
    display: flex; align-items: center; justify-content: center;
    font-weight: 700;
    font-size: 0.88rem;
    flex-shrink: 0;
  }
  .legal-section h2 {
    font-size: 1.15rem;
    font-weight: 700;
    margin: 0;
    color: var(--color-ink);
    font-family: 'Calistoga', serif;
  }
  .legal-section p {
    font-size: 0.94rem;
    color: var(--color-ink-soft);
    line-height: 1.75;
    margin-bottom: 0.85rem;
  }
  .legal-section p:last-child { margin-bottom: 0; }
  .legal-section ul, .legal-section ol {
    padding-left: 1.4rem;
    margin-bottom: 0.85rem;
  }
  .legal-section li {
    font-size: 0.94rem;
    color: var(--color-ink-soft);
    line-height: 1.7;
    margin-bottom: 0.35rem;
  }
  .legal-section ul li::marker { color: #2c5364; }
  .legal-section strong { color: var(--color-ink); font-weight: 600; }

  .legal-highlight {
    background: linear-gradient(135deg, #f0f7ff, #fff);
    border-left: 3px solid #2c5364;
    border-radius: 0 12px 12px 0;
    padding: 1rem 1.2rem;
    margin: 1rem 0;
    font-size: 0.91rem;
    color: var(--color-ink-soft);
    line-height: 1.65;
  }
  .legal-highlight strong { color: #1a4a5c; }

  .data-table {
    width: 100%;
    border-collapse: collapse;
    font-size: 0.9rem;
    margin: 1rem 0;
  }
  .data-table th {
    background: var(--color-bg);
    padding: 10px 14px;
    text-align: left;
    font-weight: 600;
    color: var(--color-ink);
    border-bottom: 2px solid var(--color-border);
    font-size: 0.82rem;
    text-transform: uppercase;
    letter-spacing: 0.05em;
  }
  .data-table td {
    padding: 10px 14px;
    border-bottom: 1px solid var(--color-border);
    color: var(--color-ink-soft);
    vertical-align: top;
  }
  .data-table tr:last-child td { border-bottom: none; }

  .rights-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 12px;
    margin: 1rem 0;
  }
  .rights-card {
    background: var(--color-bg);
    border: 1px solid var(--color-border);
    border-radius: 12px;
    padding: 1rem;
    display: flex;
    gap: 10px;
    align-items: flex-start;
  }
  .rights-card i {
    color: #2c5364;
    font-size: 1rem;
    margin-top: 2px;
    flex-shrink: 0;
  }
  .rights-card strong {
    display: block;
    font-size: 0.88rem;
    margin-bottom: 2px;
    color: var(--color-ink);
  }
  .rights-card p {
    font-size: 0.82rem !important;
    margin: 0 !important;
    color: var(--color-ink-soft);
    line-height: 1.5 !important;
  }

  .legal-contact-card {
    background: linear-gradient(135deg, #0f2027, #203a43);
    border-radius: 20px;
    padding: 2rem;
    color: #fff;
    margin-top: 2rem;
    text-align: center;
  }
  .legal-contact-card h3 {
    font-size: 1.2rem;
    font-weight: 700;
    margin-bottom: 0.5rem;
    font-family: 'Calistoga', serif;
  }
  .legal-contact-card p {
    font-size: 0.9rem;
    opacity: 0.75;
    margin-bottom: 1.25rem;
  }
  .legal-contact-card a {
    color: #fff;
    background: rgba(255,255,255,0.15);
    border: 1px solid rgba(255,255,255,0.2);
    padding: 8px 20px;
    border-radius: 20px;
    text-decoration: none;
    font-weight: 500;
    font-size: 0.9rem;
    transition: background 0.2s;
  }
  .legal-contact-card a:hover { background: rgba(255,255,255,0.25); }

  @media (max-width: 576px) {
    .rights-grid { grid-template-columns: 1fr; }
  }
</style>

<div class="legal-page">

  <!-- Hero -->
  <div class="legal-hero">
    <div class="legal-hero-icon"><i class="fa-solid fa-shield-halved"></i></div>
    <h1>Privacy Policy</h1>
    <p class="subtitle">Your privacy matters deeply to us. This policy explains what data we collect, how we use it, and the controls you have over your personal information.</p>
    <div class="legal-updated">
      <i class="fa-regular fa-calendar"></i> Last updated: July 1, 2025
    </div>
  </div>

  <div class="row g-4">
    <!-- Table of Contents -->
    <div class="col-lg-3 d-none d-lg-block">
      <div class="legal-toc">
        <h2>Contents</h2>
        <ol>
          <li><a href="#overview">Overview</a></li>
          <li><a href="#data-collected">Data We Collect</a></li>
          <li><a href="#how-we-use">How We Use Data</a></li>
          <li><a href="#sharing">Data Sharing</a></li>
          <li><a href="#cookies">Cookies & Tracking</a></li>
          <li><a href="#storage">Data Storage & Security</a></li>
          <li><a href="#retention">Data Retention</a></li>
          <li><a href="#your-rights">Your Rights</a></li>
          <li><a href="#children">Children's Privacy</a></li>
          <li><a href="#third-party">Third-Party Links</a></li>
          <li><a href="#changes">Policy Changes</a></li>
          <li><a href="#contact">Contact Us</a></li>
        </ol>
      </div>
    </div>

    <!-- Sections -->
    <div class="col-lg-9">

      <!-- 1 -->
      <div class="legal-section" id="overview">
        <div class="legal-section-header">
          <div class="legal-section-num">1</div>
          <h2>Overview</h2>
        </div>
        <p>StayNest Private Limited ("StayNest," "we," "us," or "our") is committed to protecting your personal information and your right to privacy. This Privacy Policy describes how we collect, use, disclose, and safeguard your information when you use the StayNest platform.</p>
        <p>This policy applies to all users of the StayNest website and mobile applications, including both Hosts and Guests. It is intended to give you a clear, transparent, and honest account of our data practices.</p>
        <div class="legal-highlight">
          <strong>Privacy by Design:</strong> StayNest is built with privacy as a foundational principle. We collect only what we need, retain it only as long as necessary, and give you meaningful control over your data.
        </div>
      </div>

      <!-- 2 -->
      <div class="legal-section" id="data-collected">
        <div class="legal-section-header">
          <div class="legal-section-num">2</div>
          <h2>Data We Collect</h2>
        </div>
        <p>We collect information in three main ways: information you provide to us directly, information collected automatically when you use our services, and information from third parties.</p>

        <table class="data-table">
          <thead>
            <tr>
              <th>Category</th>
              <th>Examples</th>
              <th>Source</th>
            </tr>
          </thead>
          <tbody>
            <tr>
              <td><strong>Account Information</strong></td>
              <td>Full name, email address, phone number, username, profile photo</td>
              <td>Provided by you</td>
            </tr>
            <tr>
              <td><strong>Identity Verification</strong></td>
              <td>Government-issued ID, selfie for biometric verification (Hosts only)</td>
              <td>Provided by you</td>
            </tr>
            <tr>
              <td><strong>Payment Information</strong></td>
              <td>Card number (last 4 digits), billing address, UPI ID, bank account details (Hosts)</td>
              <td>Provided by you via payment processor</td>
            </tr>
            <tr>
              <td><strong>Listing Information</strong></td>
              <td>Property address, photos, amenities, pricing, availability calendar</td>
              <td>Provided by Hosts</td>
            </tr>
            <tr>
              <td><strong>Usage Data</strong></td>
              <td>Pages visited, search queries, clicks, booking history, reviews written</td>
              <td>Collected automatically</td>
            </tr>
            <tr>
              <td><strong>Device Data</strong></td>
              <td>IP address, browser type, operating system, device identifiers, time zone</td>
              <td>Collected automatically</td>
            </tr>
            <tr>
              <td><strong>Location Data</strong></td>
              <td>Approximate location from IP; precise location if permission granted</td>
              <td>Collected automatically / with consent</td>
            </tr>
            <tr>
              <td><strong>Communications</strong></td>
              <td>Messages between Hosts and Guests on the Platform, support tickets</td>
              <td>Provided by you</td>
            </tr>
          </tbody>
        </table>
      </div>

      <!-- 3 -->
      <div class="legal-section" id="how-we-use">
        <div class="legal-section-header">
          <div class="legal-section-num">3</div>
          <h2>How We Use Your Data</h2>
        </div>
        <p>We use the information we collect for the following purposes:</p>
        <ul>
          <li><strong>Account management:</strong> Creating and maintaining your account, authenticating your identity, and enabling core features.</li>
          <li><strong>Facilitating bookings:</strong> Connecting Guests with Hosts, processing payments, and managing reservations.</li>
          <li><strong>Communication:</strong> Sending booking confirmations, receipts, updates, and service notifications.</li>
          <li><strong>Safety and fraud prevention:</strong> Verifying identities, detecting suspicious activity, and protecting users from fraud or harm.</li>
          <li><strong>Customer support:</strong> Responding to your enquiries, resolving disputes, and improving our services based on your feedback.</li>
          <li><strong>Personalisation:</strong> Tailoring search results, recommendations, and promotions based on your preferences and behaviour.</li>
          <li><strong>Analytics and improvement:</strong> Understanding how users interact with the Platform to improve performance, features, and user experience.</li>
          <li><strong>Legal compliance:</strong> Fulfilling our legal obligations, responding to lawful requests from authorities, and enforcing our Terms.</li>
          <li><strong>Marketing:</strong> Sending promotional emails about new features, special offers, and events (with your consent, and you may opt out at any time).</li>
        </ul>
        <p>We process your data based on the following legal bases: contract performance, legitimate interests, legal obligation, and your consent where applicable.</p>
      </div>

      <!-- 4 -->
      <div class="legal-section" id="sharing">
        <div class="legal-section-header">
          <div class="legal-section-num">4</div>
          <h2>Data Sharing & Disclosure</h2>
        </div>
        <p><strong>We do not sell your personal data.</strong> We share your information only in the following circumstances:</p>
        <ul>
          <li><strong>Between Hosts and Guests:</strong> When a booking is confirmed, relevant profile information (name, profile photo, approximate location) is shared between the parties.</li>
          <li><strong>Service Providers:</strong> We share data with trusted third-party service providers who assist in operating the Platform (payment processors, cloud storage, email delivery, analytics). These providers are contractually bound to protect your data and use it only for specified purposes.</li>
          <li><strong>Legal Requirements:</strong> We may disclose your information when required by law, court order, or government authority, or when necessary to protect the rights, property, or safety of StayNest, our users, or the public.</li>
          <li><strong>Business Transfers:</strong> In the event of a merger, acquisition, or sale of all or a portion of our business, your data may be transferred to the acquiring entity, subject to the same privacy protections.</li>
          <li><strong>With Your Consent:</strong> We may share your data for other purposes with your explicit consent.</li>
        </ul>
        <div class="legal-highlight">
          <strong>Third-Party Processors include:</strong> Cloudinary (image storage), Razorpay/Stripe (payments), PostgreSQL (database), SendGrid (email), and Google Analytics (usage analytics). Each is bound by data processing agreements.
        </div>
      </div>

      <!-- 5 -->
      <div class="legal-section" id="cookies">
        <div class="legal-section-header">
          <div class="legal-section-num">5</div>
          <h2>Cookies & Tracking Technologies</h2>
        </div>
        <p>We use cookies and similar tracking technologies to enhance your experience on StayNest. These include:</p>
        <ul>
          <li><strong>Essential Cookies:</strong> Required for the Platform to function (session management, authentication). Cannot be disabled.</li>
          <li><strong>Performance Cookies:</strong> Collect anonymous data about how users interact with the Platform to help us improve it (e.g., Google Analytics).</li>
          <li><strong>Functionality Cookies:</strong> Remember your preferences such as language, currency, and recent searches.</li>
          <li><strong>Marketing Cookies:</strong> Used to deliver relevant advertisements. You can opt out of these through your account settings.</li>
        </ul>
        <p>You can manage or delete cookies through your browser settings at any time. Note that disabling essential cookies may affect the Platform's functionality.</p>
      </div>

      <!-- 6 -->
      <div class="legal-section" id="storage">
        <div class="legal-section-header">
          <div class="legal-section-num">6</div>
          <h2>Data Storage & Security</h2>
        </div>
        <p>Your data is stored on secure servers hosted in India and, where applicable, in the European Union. We implement industry-standard security measures including:</p>
        <ul>
          <li>TLS/SSL encryption for all data transmitted between your browser and our servers.</li>
          <li>AES-256 encryption for sensitive data at rest.</li>
          <li>Multi-factor authentication for internal systems access.</li>
          <li>Regular security audits and penetration testing.</li>
          <li>Strict access controls — only authorised personnel can access personal data on a need-to-know basis.</li>
          <li>Regular automated backups with disaster recovery procedures.</li>
        </ul>
        <p>While we take all reasonable precautions, no method of electronic transmission or storage is 100% secure. If you believe your account has been compromised, contact us immediately at <strong>security@staynest.in</strong>.</p>
      </div>

      <!-- 7 -->
      <div class="legal-section" id="retention">
        <div class="legal-section-header">
          <div class="legal-section-num">7</div>
          <h2>Data Retention</h2>
        </div>
        <p>We retain your personal data only for as long as necessary to fulfil the purposes outlined in this policy, or as required by law:</p>
        <ul>
          <li><strong>Account data:</strong> Retained for the lifetime of your account plus 3 years after deletion (for fraud prevention and legal compliance).</li>
          <li><strong>Booking and payment records:</strong> Retained for 7 years as required by Indian financial regulations.</li>
          <li><strong>Reviews:</strong> Retained indefinitely unless you request deletion and they don't affect another user's safety.</li>
          <li><strong>Usage logs:</strong> Retained for 90 days.</li>
          <li><strong>Support communications:</strong> Retained for 2 years after resolution.</li>
        </ul>
        <p>After the retention period, your data is securely deleted or anonymised so it can no longer be associated with you.</p>
      </div>

      <!-- 8 -->
      <div class="legal-section" id="your-rights">
        <div class="legal-section-header">
          <div class="legal-section-num">8</div>
          <h2>Your Privacy Rights</h2>
        </div>
        <p>As a StayNest user, you have the following rights over your personal data under applicable law (including PDPB and GDPR where applicable):</p>

        <div class="rights-grid">
          <div class="rights-card">
            <i class="fa-solid fa-eye"></i>
            <div>
              <strong>Right to Access</strong>
              <p>Request a copy of the personal data we hold about you.</p>
            </div>
          </div>
          <div class="rights-card">
            <i class="fa-solid fa-pen-to-square"></i>
            <div>
              <strong>Right to Rectification</strong>
              <p>Correct inaccurate or incomplete personal data.</p>
            </div>
          </div>
          <div class="rights-card">
            <i class="fa-solid fa-trash-can"></i>
            <div>
              <strong>Right to Erasure</strong>
              <p>Request deletion of your data ("right to be forgotten").</p>
            </div>
          </div>
          <div class="rights-card">
            <i class="fa-solid fa-ban"></i>
            <div>
              <strong>Right to Restrict Processing</strong>
              <p>Limit how we use your data in certain circumstances.</p>
            </div>
          </div>
          <div class="rights-card">
            <i class="fa-solid fa-file-export"></i>
            <div>
              <strong>Right to Data Portability</strong>
              <p>Receive your data in a structured, machine-readable format.</p>
            </div>
          </div>
          <div class="rights-card">
            <i class="fa-solid fa-hand"></i>
            <div>
              <strong>Right to Object</strong>
              <p>Object to processing based on legitimate interests or for direct marketing.</p>
            </div>
          </div>
        </div>

        <p>To exercise any of these rights, contact our Data Protection Officer at <strong>privacy@staynest.in</strong>. We will respond within 30 days. Some rights may be limited where we have a legal obligation to retain your data.</p>
      </div>

      <!-- 9 -->
      <div class="legal-section" id="children">
        <div class="legal-section-header">
          <div class="legal-section-num">9</div>
          <h2>Children's Privacy</h2>
        </div>
        <p>StayNest is not intended for use by individuals under the age of 18. We do not knowingly collect personal data from children. If we become aware that we have inadvertently collected data from a child, we will take immediate steps to delete it.</p>
        <p>If you are a parent or guardian and believe your child has provided us with personal information, please contact us at <strong>privacy@staynest.in</strong> so we can take appropriate action.</p>
      </div>

      <!-- 10 -->
      <div class="legal-section" id="third-party">
        <div class="legal-section-header">
          <div class="legal-section-num">10</div>
          <h2>Third-Party Links</h2>
        </div>
        <p>Our Platform may contain links to third-party websites, social media platforms, and services. This Privacy Policy does not apply to those external sites. We encourage you to review the privacy policies of any third-party sites you visit.</p>
        <p>StayNest is not responsible for the privacy practices or content of external websites, even if you access them through links on our Platform.</p>
      </div>

      <!-- 11 -->
      <div class="legal-section" id="changes">
        <div class="legal-section-header">
          <div class="legal-section-num">11</div>
          <h2>Changes to This Policy</h2>
        </div>
        <p>We may update this Privacy Policy from time to time to reflect changes in our practices, technologies, legal requirements, or for other operational reasons. When we make significant changes, we will:</p>
        <ul>
          <li>Update the "Last Updated" date at the top of this page.</li>
          <li>Send a notification email to all registered users.</li>
          <li>Display a prominent notice on the Platform for at least 30 days.</li>
        </ul>
        <p>We encourage you to review this policy periodically. Your continued use of StayNest after changes take effect constitutes acceptance of the updated policy.</p>
      </div>

      <!-- 12 -->
      <div class="legal-section" id="contact">
        <div class="legal-section-header">
          <div class="legal-section-num">12</div>
          <h2>Contact Us</h2>
        </div>
        <p>If you have questions, concerns, or requests regarding this Privacy Policy or how we handle your data, please contact:</p>
        <ul>
          <li><strong>Data Protection Officer:</strong> privacy@staynest.in</li>
          <li><strong>Security concerns:</strong> security@staynest.in</li>
          <li><strong>General support:</strong> support@staynest.in</li>
          <li><strong>Mailing address:</strong> StayNest Private Limited, 4th Floor, Tech Park, Koramangala, Bengaluru – 560034, Karnataka, India</li>
        </ul>
        <p>If you are not satisfied with our response, you have the right to lodge a complaint with the appropriate data protection authority in your jurisdiction.</p>
      </div>

      <!-- Contact Card -->
      <div class="legal-contact-card">
        <i class="fa-solid fa-shield-halved fa-2x mb-3" style="opacity: 0.8;"></i>
        <h3>Your Privacy, Our Priority</h3>
        <p>Questions about how we handle your data? Our privacy team is here to help.</p>
        <a href="mailto:privacy@staynest.in"><i class="fa-solid fa-envelope me-2"></i>Contact Privacy Team</a>
      </div>

    </div>
  </div>
</div>
