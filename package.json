{
  "engines": {
    "node": ">=18.0.0"
  },
  "name": "staynest",
  "version": "1.0.0",
  "description": "StayNest - Short-term vacation rental marketplace",
  "main": "main.js",
  "scripts": {
    "start": "node app.js",
    "seed": "node prisma/seed.js",
    "electron:start": "electron .",
    "dist": "electron-builder --win"
  },
  "build": {
    "appId": "com.staynest.app",
    "productName": "StayNest",
    "directories": {
      "output": "dist"
    },
    "files": [
      "**/*",
      "!dist/**",
      "!.git/**",
      {
        "from": "node_modules/.prisma",
        "to": "node_modules/.prisma"
      }
    ],
    "extraResources": [
      {
        "from": ".env",
        "to": ".env"
      },
      {
        "from": "node_modules/.prisma",
        "to": "node_modules/.prisma"
      }
    ],
    "asar": true,
    "forceCodeSigning": false,
    "win": {
      "target": [
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ],
      "requestedExecutionLevel": "asInvoker",
      "legalTrademarks": "StayNest",
      "cscLink": "staynest.pfx",
      "cscKeyPassword": "staynest123"
    },
    "portable": {
      "artifactName": "StayNest.exe"
    }
  },
  "keywords": [],
  "author": "StayNest",
  "license": "ISC",
  "type": "commonjs",
  "dependencies": {
    "@prisma/adapter-pg": "^7.10.0",
    "@prisma/client": "^7.10.0",
    "bcryptjs": "^3.0.3",
    "cloudinary": "^1.41.3",
    "connect-flash": "^0.1.1",
    "cookie-parser": "^1.4.7",
    "dotenv": "^17.4.2",
    "ejs": "^6.0.1",
    "ejs-mate": "^4.0.0",
    "express": "^5.2.1",
    "express-session": "^1.19.0",
    "joi": "^18.2.3",
    "method-override": "^3.0.0",
    "multer": "^2.2.0",
    "multer-storage-cloudinary": "^4.0.0",
    "passport": "^0.7.0",
    "passport-local": "^1.0.0"
  },
  "devDependencies": {
    "electron": "^44.4.3",
    "electron-builder": "^26.15.3",
    "prisma": "7.10.0"
  }
}
